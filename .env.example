# ===== Discord =====
DISCORD_TOKEN=
# 貼原文的頻道
INPUT_CHANNEL_ID=
# 待發文區（審稿頻道）
REVIEW_CHANNEL_ID=
# 可以按 emoji 發文的身分組 ID，多個用逗號分隔；留空 = 所有人都能發（不建議）
REVIEWER_ROLE_IDS=

# ===== Claude =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ===== 測試模式：true = 按 emoji 不會真的發文，只會在 log 印出 =====
DRY_RUN=true

# ===== Threads（沒填就不會啟用）=====
# 可留空（預設用 me）
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ===== Instagram（Instagram API with Instagram Login，需為專業帳號）=====
# 可留空（預設用 me）
IG_USER_ID=
IG_ACCESS_TOKEN=
